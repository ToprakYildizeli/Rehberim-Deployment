# LGS backend — Railway → servis → Variables
#
# BU DOSYAYA GERCEK DEGER YAZILMAZ. Repo herkese acik; buradaki her sey
# yer tutucudur. Gercek degerler yalniz Railway'in kendi ekraninda durur.
#
# Backend'in okudugu degiskenlerin TAM listesi ve aciklamalari kaynak repo'da:
#   Rehberim-Backend-LGS/.env.example
#
# !! LGS, YKS'den AYRI bir urun: ayri Railway projesi, ayri PostgreSQL, ayri
#    SECRET_KEY. YKS'nin degerlerini kopyalama.

# --- Temel ---------------------------------------------------------------
# DJANGO_DEBUG TANIMLANMAZ. Tanimsizsa ayar dosyasi DEBUG'i kapali sayar ve
# SECRET_KEY / DATABASE_URL eksikse uygulama ACILMAZ.

# python -c "import secrets; print(secrets.token_urlsafe(64))" ile uret.
# Depodaki "django-insecure-dev-only-change-in-prod" KULLANILMAZ.
DJANGO_SECRET_KEY=<yeni-uretilmis-anahtar>

# Platformun kendi adresi de LISTEDE OLMALI: saglik yoklamasi ic agdan,
# farkli bir Host basligiyla geliyor. Yoksa dagitim "never became healthy"
# ile iptal edilir.
DJANGO_ALLOWED_HOSTS=${{RAILWAY_PUBLIC_DOMAIN}},.railway.app,api-lgs.rehberim.xyz
DJANGO_CSRF_TRUSTED_ORIGINS=https://api-lgs.rehberim.xyz

# !! Degiskenin adi YKS'dekinden farkli: orada DJANGO_CORS_ALLOWED_ORIGINS.
CORS_ALLOWED_ORIGINS=https://lgs.rehberim.xyz

# --- Veritabani ----------------------------------------------------------
# Railway PostgreSQL eklentisinin degiskenine REFERANSLA baglanir, elle
# kopyalanmaz: parola dondugunde referans kendini gunceller.
# Uretimde zorunlu; tanimsizsa uygulama acilmaz (SQLite'a dusmez).
DATABASE_URL=<PostgreSQL eklentisinin ic ag adresi>

# --- Dosyalar ------------------------------------------------------------
# YOK. LGS'de kullanici yuklemesi olmadigi icin kalici disk (volume) ve
# DJANGO_MEDIA_ROOT / DJANGO_SERVE_MEDIA gerekmiyor. YKS'de gerekiyordu.

# --- Gunluk ---------------------------------------------------------------
# Kok gunlukcunun esigi. 500'ler (traceback'iyle) bu ayardan bagimsiz olarak
# her zaman stderr'e yazilir.
DJANGO_LOG_LEVEL=INFO

# --- E-posta (Resend) ----------------------------------------------------
# Tanimsiz birakilirsa postalar konsola yazilir ve sifresini unutan ogretmen
# sifirlama baglantisini HICBIR ZAMAN alamaz.
# !! PORT 2587 - Railway 587'yi engelliyor ve baglanti reddedilmiyor, suresiz
#    asili kaliyor. Ayrinti: docs/email-resend.md
DJANGO_EMAIL_HOST=<Resend SMTP sunucusu>
DJANGO_EMAIL_PORT=2587
DJANGO_EMAIL_HOST_USER=<Resend SMTP kullanicisi>
DJANGO_EMAIL_HOST_PASSWORD=<Resend API anahtari>
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=Rehberim LGS <noreply@rehberim.xyz>

# Sifirlama baglantisi dershane panelini gosterir; {uid} ve {token} sunucu
# tarafindan doldurulur. Yanlis kalirsa postadaki baglanti localhost gosterir.
DJANGO_PASSWORD_RESET_URL=https://lgs.rehberim.xyz/sifre-sifirla/{uid}/{token}

# --- Hiz siniri ----------------------------------------------------------
# Sayac onbellekte ve islem basina ayri; paylasimli onbellek (Redis) gelene
# kadar bu bir tavan degil, yavaslatici.
# DJANGO_THROTTLE_PASSWORD_RESET=5/hour

# --- Hata izleme ---------------------------------------------------------
# YOK. LGS kodunda Sentry entegrasyonu henuz yazilmadi (YKS'de var).

# --- HTTPS ---------------------------------------------------------------
# Ters vekil arkasindayiz; ikisi de varsayilan olarak acik, yazmaya gerek yok.
# DJANGO_BEHIND_PROXY=1
# DJANGO_SECURE_SSL_REDIRECT=1

# HSTS'i EN SON ac ve ancak HTTPS'in calistigini gozunle gordukten sonra.
# Bir kez yayinlaninca geri donusu yok.
# DJANGO_HSTS_SECONDS=31536000
