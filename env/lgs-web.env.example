#
# Asagidaki degisken, barindirma panelinde tanimlanabiliyorsa koddaki secimi
# EZER. Derleme aninda pakete gomulur; gizli bir sey yazilmaz.

# VITE_API_BASE_URL=https://api-lgs.rehberim.xyz/api
