# Railway → backend servisi → Variables
#
# BU DOSYAYA GERCEK DEGER YAZILMAZ. Repo herkese acik; buradaki her sey
# yer tutucudur. Gercek degerler yalniz Railway'in kendi ekraninda durur.
#
# Backend'in okudugu degiskenlerin TAM listesi ve aciklamalari kaynak repo'da:
#   Rehberim-Backend/Django/.env.example

# --- Temel ---------------------------------------------------------------
# DJANGO_DEBUG TANIMLANMAZ. Tanimsizsa ayar dosyasi DEBUG'i kapali sayar.

# python -c "import secrets; print(secrets.token_urlsafe(64))" ile uret.
# Depodaki eski "django-insecure-..." anahtari KULLANILMAZ, o yanmis sayilir.
DJANGO_SECRET_KEY=<yeni-uretilmis-anahtar>

DJANGO_ALLOWED_HOSTS=api.rehberim.xyz
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.rehberim.xyz
DJANGO_CORS_ALLOWED_ORIGINS=https://rehberim.xyz,https://www.rehberim.xyz

# --- Veritabani ----------------------------------------------------------
# Railway PostgreSQL eklentisinin degiskenine REFERANSLA baglanir, elle
# kopyalanmaz: parola dondugunde referans kendini gunceller.
DATABASE_URL=<PostgreSQL eklentisinin ic ag adresi>

# --- Dosyalar ------------------------------------------------------------
# Kalici disk /app/media'ya baglanmis olmali; yoksa her dagitimda profil
# fotograflari silinir.
DJANGO_MEDIA_ROOT=/app/media
DJANGO_SERVE_MEDIA=1

# --- E-posta (Resend) ----------------------------------------------------
# Tanimsiz birakilirsa postalar konsola yazilir ve sifresini unutan kullanici
# sifirlama baglantisini HICBIR ZAMAN alamaz.
DJANGO_EMAIL_HOST=<Resend SMTP sunucusu>
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=<Resend SMTP kullanicisi>
DJANGO_EMAIL_HOST_PASSWORD=<Resend API anahtari>
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=Rehberim <noreply@rehberim.xyz>

# Sifirlama baglantisi rehber web'ini gosterir; {uid} ve {token} sunucu
# tarafindan doldurulur.
DJANGO_PASSWORD_RESET_URL=https://rehberim.xyz/sifre-sifirla/{uid}/{token}

# --- HTTPS ---------------------------------------------------------------
# Ters vekil arkasindayiz; ikisi de varsayilan olarak acik, yazmaya gerek yok.
# DJANGO_BEHIND_PROXY=1
# DJANGO_SECURE_SSL_REDIRECT=1

# HSTS'i EN SON ac ve ancak HTTPS'in calistigini gozunle gordukten sonra.
# Bir kez yayinlaninca geri donusu yok.
# DJANGO_HSTS_SECONDS=31536000
